---
import Layout from "@/layouts/main.astro"
import ProgramPreview from "@/components/programs/ProgramPreview.astro"
import Interest from "@/components/programs/Interest.astro"
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Welcome</p>
      <h1>Let’s build<br />a <span>robot.</span></h1>
      <p class="hero-description">
        Explore our programs, and join top FIRST teams as they compete to win!
      </p>
      <div class="hero-actions">
        <a class="button" href="/programs"
          ><span>Find your team</span><span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href="/about">What’s DAR?</a>
      </div>
      <p class="hero-footnote">No experience needed.</p>
    </div>
    <figure class="hero-photo">
      <img
        src="/dar-robot.jpg"
        alt="A DAR competition robot on the field at a FIRST robotics event"
        width="1000"
        height="667"
        fetchpriority="high"
      />
      <figcaption>
        <span>BUILT BY DAR STUDENTS</span><span>On the field ↗</span>
      </figcaption>
      <span class="photo-label" aria-hidden="true"
        >Yes, you can<br />build one of these.</span
      >
    </figure>
  </section>
  <section class="workshop-intro" aria-labelledby="workshop-title">
    <div>
      <p class="eyebrow">MORE THAN ROBOTS</p><h2 id="workshop-title">
        Find your people. <br />Make Cool Robots
      </h2>
    </div>
    <div class="workshop-description">
      <p>
        From programming, electrical, mechanical, and more, there something for everyone.
      </p><p>
        There's something for everyone!
      </p><a class="text-link" href="/about"
        >Meet Downingtown Area Robotics <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <ProgramPreview />
  <Interest />
</Layout>
