---
import Layout from "@/layouts/main.astro"
import ProgramPreview from "@/components/programs/ProgramPreview.astro"
import Interest from "@/components/programs/Interest.astro"
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Welcome</p>
      <h1>Student<br /><span>robotics.</span></h1>
      <p class="hero-description">
        Explore FIRST robotics programs for students in the Exton area.
      </p>
      <div class="hero-actions">
        <a class="button" href="/programs"
          ><span>Explore programs</span><span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href="/about">About DAR</a>
      </div>
      <p class="hero-footnote">No experience needed.</p>
    </div>
    <figure class="hero-photo">
      <img
        src="/dar-robot.jpg"
        alt="A DAR competition robot on the field at a FIRST robotics event"
        width="1000"
        height="667"
        fetchpriority="high"
      />
      <figcaption>
        <span>BUILT BY DAR STUDENTS</span><span>On the field ↗</span>
      </figcaption>
      <span class="photo-label" aria-hidden="true"
        >FRC Team 1640</span
      >
    </figure>
  </section>
  <section class="workshop-intro" aria-labelledby="workshop-title">
    <div>
      <p class="eyebrow">AT THE WORKSHOP</p><h2 id="workshop-title">
        Learn to design,<br />build, and program.
      </h2>
    </div>
    <div class="workshop-description">
      <p>
        Students work on programming, electrical systems, mechanical design, and outreach.
      </p><p>
        Volunteer mentors help students develop skills through hands-on projects.
      </p><a class="text-link" href="/about"
        >Meet Downingtown Area Robotics <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <ProgramPreview />
  <Interest />
</Layout>
