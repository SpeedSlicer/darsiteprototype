---
import Layout from "@/layouts/main.astro"
import { contact } from "@/data/contact"
const calendarUrl = import.meta.env.PUBLIC_GOOGLE_CALENDAR_EMBED_URL ||
  "https://calendar.google.com/calendar/embed?src=c_08a8a4267cfd6458046c609ca4adf5ba0998d4f72836e5f376d337c12e25352b%40group.calendar.google.com&ctz=America%2FNew_York"
---

<Layout title="Event calendar" description="Upcoming Downingtown Area Robotics meetings and events.">
  <header class="page-heading">
    <p class="eyebrow">EVENT CALENDAR</p>
    <h1>Event calendar</h1>
    <p>Meetings, competitions, and community events.</p>
  </header>
  <section class="prose" aria-label="DAR event calendar">
    {calendarUrl ? (
      <>
        <iframe src={calendarUrl} title="Downingtown Area Robotics Google Calendar" loading="lazy" class="calendar-embed" />
        <p><a href={calendarUrl} target="_blank" rel="noopener noreferrer">Open Google Calendar (opens in a new tab)</a></p>
      </>
    ) : (
      <p>For upcoming meeting and event details, <a href={`mailto:${contact.email}?subject=DAR%20calendar`}>contact DAR</a>.</p>
    )}
  </section>
</Layout>

<style>
  .calendar-embed { width: 100%; height: 650px; border: 0; border-radius: 12px; }
</style>
