---
import { contact } from "@/data/contact"
---

<section class="interest-panel" id="interest" aria-labelledby="interest-title">
  <div>
    <h2 id="interest-title">
      Interested?
    </h2><p>
      Fill out the Google Form to ask about joining a team. We’ll contact you about availability and next steps.
    </p>
  </div>
  <div class="interest-actions">
    <a
      class="button button-dark"
      href={contact.interestForm}
      target="_blank"
      rel="noopener noreferrer"
      ><span>Fill out the interest form</span><span aria-hidden="true">↗</span
      ><span class="sr-only"> (opens in a new tab)</span></a
    >
    <!--email_off-->
    <a class="text-link" href={`mailto:${contact.email}`}
      >Or email {contact.email} <span aria-hidden="true">↗</span></a
    >
  <!--/email_off-->
  </div>
</section>
